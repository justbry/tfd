{
	"name": "tfd-credentials",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Issue and verify Open Badges 3.0 credentials (W3C VC 2.0, eddsa-rdfc-2022 and eddsa-jcs-2022 Data Integrity proofs, Bitstring Status List) through injected ports, with no I/O of its own.",
	"license": "Apache-2.0",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./rdfc": {
			"types": "./dist/rdfc.d.ts",
			"bun": "./src/rdfc.ts",
			"default": "./dist/rdfc.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"bun": "./src/testing.ts",
			"default": "./dist/testing.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "bun ./build.ts",
		"test": "bun test tests",
		"ts": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
	},
	"dependencies": {
		"@noble/curves": "2.3.0",
		"@noble/hashes": "2.3.0",
		"jsonld": "9.0.0"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"typescript": "~5.8.3"
	}
}
