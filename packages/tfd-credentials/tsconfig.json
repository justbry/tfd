{
	"compilerOptions": {
		"isolatedModules": true,
		"module": "Preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"target": "ES2022",
		"lib": ["ES2023"],
		"types": ["bun"],
		"resolveJsonModule": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "build.ts"]
}
