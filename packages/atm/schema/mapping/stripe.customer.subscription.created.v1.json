{
	"v": 1,
	"source": "stripe",
	"event": "customer.subscription.created",
	"target": "SubscriptionFact",
	"stripeApiVersion": "2025-10-29.clover",
	"fields": {
		"id": {
			"path": "$.data.object.id",
			"type": "string"
		},
		"customerId": {
			"path": "$.data.object.customer",
			"type": "string"
		},
		"status": {
			"path": "$.data.object.status",
			"type": "string",
			"values": {
				"active": "active",
				"trialing": "trialing",
				"past_due": "past_due",
				"unpaid": "unpaid",
				"incomplete": "incomplete",
				"incomplete_expired": "incomplete_expired",
				"canceled": "canceled",
				"paused": "paused"
			}
		},
		"currentPeriodStart": {
			"path": "$.data.object.items.data[0].current_period_start",
			"type": "seconds"
		},
		"currentPeriodEnd": {
			"path": "$.data.object.items.data[0].current_period_end",
			"type": "seconds"
		},
		"cancelAtPeriodEnd": {
			"path": "$.data.object.cancel_at_period_end",
			"type": "bool"
		},
		"at": {
			"path": "$.created",
			"type": "seconds"
		},
		"metadata": {
			"path": "$.data.object.metadata",
			"type": "map"
		}
	},
	"lines": {
		"path": "$.data.object.items.data",
		"fields": {
			"priceId": {
				"path": "$.price.id",
				"type": "string"
			},
			"lookupKey": {
				"path": "$.price.lookup_key",
				"type": "string",
				"optional": true,
				"default": null
			},
			"interval": {
				"path": "$.price.recurring.interval",
				"type": "string",
				"optional": true,
				"default": null,
				"values": {
					"month": "month",
					"year": "year"
				},
				"fallback": null
			},
			"quantity": {
				"path": "$.quantity",
				"type": "int",
				"optional": true,
				"default": 1,
				"min": 0,
				"max": 99999999
			},
			"unitAmount": {
				"path": "$.price.unit_amount",
				"type": "int",
				"optional": true
			},
			"intervalCount": {
				"path": "$.price.recurring.interval_count",
				"type": "int",
				"optional": true
			}
		}
	},
	"personal": [
		"$.data.object.customer.email",
		"$.data.object.customer.name",
		"$.data.object.customer.address",
		"$.data.object.customer.phone"
	]
}
