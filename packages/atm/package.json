{
	"name": "tfd",
	"version": "0.11.1",
	"private": true,
	"license": "SEE LICENSE IN LICENSING.md",
	"type": "module",
	"description": "The Trifold engine, built on Autumn's balance engine: a local CLI (tfd, also atm) and a TypeScript library that run engine commands against a subject; next, build, check and replay a school's ledger.",
	"bin": {
		"atm": "./src/atm.ts",
		"tfd": "./src/bin.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./worker": {
			"types": "./dist/worker.d.ts",
			"bun": "./src/worker.ts",
			"default": "./dist/worker.js"
		},
		"./scenarios": {
			"types": "./src/scenario/api.ts",
			"bun": "./src/scenario/api.ts",
			"default": "./src/scenario/api.ts"
		}
	},
	"files": [
		"dist",
		"src",
		"fixtures/scenarios",
		"LICENSE.md",
		"LICENSING.md",
		"LICENSES"
	],
	"scripts": {
		"atm": "bun ./src/atm.ts",
		"tfd": "bun ./src/bin.ts",
		"build": "bun ./build.ts",
		"release": "bun ./release.ts",
		"test": "bun test tests",
		"ts": "tsc --noEmit",
		"fixtures": "bun ./fixtures/generate.ts",
		"schema": "bun ./schema/build.ts",
		"model": "bun ./model/build.ts",
		"stripe-spec": "bun ./schema/stripe/build.ts",
		"scenarios": "bun ./src/bin.ts scenarios",
		"bundles:gaps": "bun ./tests/author-gap-bundles.ts",
		"suppression-report": "bun ./fixtures/suppression-report.ts",
		"golden-e2e": "bun test --timeout 600000 tests/golden-e2e-check.test.ts",
		"golden-e2e:scale": "bun ./scripts/golden-e2e-scale.ts",
		"golden-e2e:kill": "bun ./scripts/golden-e2e-kill.ts",
		"org-demos": "bun ./scripts/org-demos/build.ts"
	},
	"dependencies": {
		"@autumn/balance-engine": "workspace:*",
		"ajv": "8.20.0",
		"aws4fetch": "1.0.20",
		"commander": "14.0.3"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"esbuild": "0.25.0",
		"miniflare": "4.20260730.0",
		"typescript": "~5.8.3"
	}
}
