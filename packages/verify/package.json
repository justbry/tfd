{
	"name": "tfd-verify",
	"version": "0.1.0",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"description": "Verify Trifold receipts and seals anywhere WebCrypto runs: tfd's receipt and seal checks, ported line for line. Browser-safe, no node:* imports.",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/core.ts",
			"default": "./src/core.ts"
		},
		"./check": {
			"types": "./src/check.ts",
			"default": "./src/check.ts"
		},
		"./link": {
			"types": "./src/link.ts",
			"default": "./src/link.ts"
		}
	},
	"files": [
		"src",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"test": "bun test tests",
		"ts": "tsc --noEmit"
	},
	"dependencies": {
		"@noble/ed25519": "^3.2.0"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"typescript": "5.8.3"
	}
}
