{
	"name": "ledger-ui-svelte",
	"private": true,
	"type": "module",
	"description": "The ledger admin UI rewrite (S9, D20): Svelte 5, Tailwind 4, shadcn-svelte and Effect, beside the Preact packages/ledger-ui, whose Reader/Writer contract, fixtures and HTTP adapters it imports read-only. See plans/ledger-ui/S9-plan.md.",
	"scripts": {
		"fixtures": "bun --cwd ../ledger-ui scripts/import-mart.ts",
		"dev": "bun run fixtures && vite",
		"build": "bun run fixtures && vite build",
		"build:size": "vite build --config gates/vite.size.config.ts",
		"preview": "vite preview",
		"test": "bun run fixtures && bun scripts/test-all.ts",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"gates": "bun gates/run.ts",
		"shots": "bun scripts/shots.ts"
	},
	"dependencies": {
		"effect": "4.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.2",
		"@happy-dom/global-registrator": "20.0.10",
		"@internationalized/date": "3.12.4",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/bun": "1.4.2",
		"bits-ui": "2.20.6",
		"clsx": "2.1.1",
		"happy-dom": "20.0.10",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "5.8.3",
		"vite": "8.3.6"
	}
}
