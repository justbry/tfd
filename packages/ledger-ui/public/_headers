# Workers static assets (packages/ledger-worker/wrangler.jsonc `assets.directory` is this build's dist/).
# Vite's files under /assets/ carry a content hash in their names: a browser may keep them for a year and never ask
# again. The page itself is always revalidated, so a deploy's new hashes are picked up on the next load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
