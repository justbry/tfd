{
	"name": "trifold-site",
	"version": "0.1.0",
	"private": true,
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"description": "The Trifold marketing website: a SvelteKit static site for Cloudflare Pages.",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "bun ../../catalog/trifold/check.ts && svelte-kit sync && vite build && bun ./scripts/agent-files.ts",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"samples": "bun ./scripts/make-samples.ts",
		"org-demos:sync": "bun ./scripts/sync-org-demos.ts",
		"test": "bun test tests",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.70.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.4",
		"@types/turndown": "^5.0.6",
		"bits-ui": "^2.20.0",
		"clsx": "^2.1.1",
		"mdsvex": "^0.12.8",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.5",
		"turndown": "^7.2.5",
		"turndown-plugin-gfm": "^1.0.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6",
		"vite": "^8.3.6"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"tfd-verify": "file:../../packages/verify"
	}
}
