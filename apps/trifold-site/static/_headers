# Cloudflare Pages headers. Prerendered pages also carry a <meta> CSP from SvelteKit that allows only the hashed inline
# scripts (its bootstrap and the theme script); this header's 'unsafe-inline' for scripts is narrowed by that meta CSP,
# since a browser enforces both. Inline styles are allowed (component style attributes). No third-party origins.
# connect-src/form-action are 'self': the early-access form posts to PUBLIC_FORM_ENDPOINT, which is
# https://trifold.app/api/early-access, served by the apex Worker on this origin (apps/trifold-apex). mailto: stays for
# builds without an endpoint.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The demo orgs' KPI dashboards (copied by scripts/sync-org-demos.ts), framed by the audience pages on this origin.
# Each page is one self-contained file: an inline script and style, its data as inline JSON, no requests. So the site's
# CSP and DENY are detached and replaced with a stricter policy that lets only this origin frame them.
/demo/orgs/*
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; frame-ancestors 'self'; base-uri 'none'; form-action 'none'
  X-Frame-Options: SAMEORIGIN
  X-Robots-Tag: noindex

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

# Agent files (scripts/agent-files.ts). llms.txt stays indexable; llms-full.txt and the .md mirrors repeat the pages,
# so they're noindex. Each mirror's block is appended to build/_headers by that script, since the mirrors follow the
# pages and competitors.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex
