/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://staging-api.trifold.app https://api.trifold.app; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'

/.well-known/trifold-keys.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
